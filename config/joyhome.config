# JoyHome KNX Home Server changes on top of Armbian's rockchip64 6.18 config
# (merged with scripts/kconfig/merge_config.sh, then olddefconfig).

# JoyHome's external hardware watchdog on GPIO4_C3 must be fed from the
# earliest boot stage, or the board resets: built in, at arch_initcall.
CONFIG_WATCHDOG=y
CONFIG_GPIO_WATCHDOG=y
CONFIG_GPIO_WATCHDOG_ARCH_INITCALL=y

# DS1307 battery-backed RTC on I2C2 (added by /etc/rc.local)
CONFIG_RTC_DRV_DS1307=y

# KNX on ttyS3, Zigbee on ttyS7, room for ttyS9
CONFIG_SERIAL_8250_NR_UARTS=10
CONFIG_SERIAL_8250_RUNTIME_UARTS=10

# crash log area from the device tree, available early
CONFIG_PSTORE_RAM=y

CONFIG_LOCALVERSION="-joyhome"
# CONFIG_LOCALVERSION_AUTO is not set

# smaller, faster build: no debug info, no module signing
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_MODULE_SIG is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# hardware this box can't use (cameras/TV tuners, PCIe graphics, InfiniBand, ISDN, ham radio)
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_I915 is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ISDN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_SND_SOC_SOF_TOPLEVEL is not set
