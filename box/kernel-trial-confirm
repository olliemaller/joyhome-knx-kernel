#!/bin/bash
# Confirms a trial boot on the JoyHome KNX box once it's healthy, or reboots
# so u-boot falls back (see /boot/boot.cmd):
#   ktrial.txt      a new kernel is on trial  -> on success write knew.txt
#   npupending.txt  the NPU device tree is on trial -> on success delete it
# Does nothing on 5.10 or when nothing is on trial.
B=/boot
case "$(uname -r)" in 5.10*) exit 0 ;; esac
kernel_trial=""; npu_trial=""
[ -e "$B/ktrial.txt" ] && kernel_trial=1
[ -e "$B/npupending.txt" ] && tr -d '\0' < /proc/device-tree/model | grep -q "+ NPU" && npu_trial=1
[ -n "$kernel_trial$npu_trial" ] || exit 0

log() { logger -t kernel-trial "$*"; echo "$*"; }
fail=""
# give the network, Docker and Home Assistant time to start
for i in $(seq 1 30); do
	ip -4 addr show dev end1 2>/dev/null | grep -q "inet " && break
	sleep 10
done
ip -4 addr show dev end1 2>/dev/null | grep -q "inet " || fail="$fail no-ethernet-ip"
[ -c /dev/ttyS3 ] || fail="$fail no-ttyS3(KNX)"
[ -e /dev/knx ] || fail="$fail no-/dev/knx"
systemctl is-active --quiet docker || fail="$fail docker-not-running"
[ -e /sys/class/rtc/rtc0 ] || fail="$fail no-rtc"

if [ -z "$fail" ]; then
	if [ -n "$kernel_trial" ]; then
		echo confirmed > "$B/knew.txt"
		rm -f "$B/ktrial.txt" "$B/karmed.txt"
		log "trial confirmed on $(uname -r): this kernel is now the default"
	fi
	if [ -n "$npu_trial" ]; then
		rm -f "$B/npupending.txt"
		log "NPU boot confirmed on $(uname -r)"
	fi
	sync
else
	log "trial FAILED:$fail. Rebooting; u-boot will fall back"
	sync
	sleep 5
	systemctl reboot
fi
