# DO NOT EDIT THIS FILE
#
# Please edit /boot/orangepiEnv.txt to set supported parameters
#
# JoyHome KNX Home Server:
#   new     : 6.18 LTS, built by github.com/olliemaller/joyhome-knx-kernel
#             (/boot/Image, /boot/uInitrd, /boot/joyhome/rk3566-joyhome-knx.dtb,
#             no overlays). Put there by /etc/kernel/postinst.d/zz-joyhome-boot.
#   fallback: Orange Pi 5.10    (/boot/k510/...)  with the overlays in
#             orangepiEnv.txt, exactly as JoyHome shipped it
#
# Trial / fallback flags in /boot (written by this script with fatwrite):
#   (no flag)   boot 5.10 - the safe default.
#   karmed.txt  6.18 is on trial. Each boot writes ktrial.txt first.
#   ktrial.txt  a 6.18 boot started. kernel-trial-confirm.service deletes it
#               (and karmed.txt) and writes knew.txt once the box is healthy.
#   knew.txt    6.18 confirmed: boot 6.18.
#   kold.txt    boot 5.10 whatever else is there. Written when a boot finds
#               ktrial.txt still there (the previous 6.18 boot never confirmed).
#   npu.txt / npupending.txt / npuoff.txt: experimental NPU device tree, with
#               the same trial-and-fallback idea (see below and joyhome-npu).
#
# Recompile with:
# mkimage -C none -A arm -T script -d /boot/boot.cmd /boot/boot.scr

setenv load_addr "0x9000000"
setenv overlay_error "false"
# default values
setenv rootdev "/dev/mmcblk0p1"
setenv verbosity "1"
setenv console "both"
setenv bootlogo "false"
setenv rootfstype "ext4"
setenv docker_optimizations "on"
setenv earlycon "off"

echo "Boot script loaded from ${devtype} ${devnum}"

if test -e ${devtype} ${devnum} ${prefix}orangepiEnv.txt; then
	load ${devtype} ${devnum} ${load_addr} ${prefix}orangepiEnv.txt
	env import -t ${load_addr} ${filesize}
fi

if test "${logo}" = "disabled"; then setenv logo "logo.nologo"; fi

if test "${console}" = "display" || test "${console}" = "both"; then setenv consoleargs "console=tty1"; fi
if test "${console}" = "serial" || test "${console}" = "both"; then setenv consoleargs "console=ttyS2,1500000 ${consoleargs}"; fi
if test "${earlycon}" = "on"; then setenv consoleargs "earlycon ${consoleargs}"; fi
if test "${bootlogo}" = "true"; then
        setenv consoleargs "splash plymouth.ignore-serial-consoles ${consoleargs}"
else
        setenv consoleargs "splash=verbose ${consoleargs}"
fi

if test "${devtype}" = "mmc"; then part uuid mmc ${devnum}:1 partuuid; fi

# ---------------- kernel choice ----------------
setenv kold "false"
if test -e ${devtype} ${devnum} ${prefix}kold.txt; then
	echo "kold.txt present: booting 5.10"
	setenv kold "true"
elif test -e ${devtype} ${devnum} ${prefix}ktrial.txt; then
	echo "Last 6.18 boot never confirmed: falling back to 5.10"
	fatwrite ${devtype} ${devnum}:1 ${load_addr} kold.txt 1
	setenv kold "true"
elif test -e ${devtype} ${devnum} ${prefix}karmed.txt; then
	echo "6.18 trial boot (karmed.txt)"
	fatwrite ${devtype} ${devnum}:1 ${load_addr} ktrial.txt 1
elif test -e ${devtype} ${devnum} ${prefix}knew.txt; then
	echo "6.18 confirmed (knew.txt)"
else
	# safe default: nothing armed or confirmed -> 5.10
	setenv kold "true"
fi
if test "${kold}" = "false"; then
	if test -e ${devtype} ${devnum} ${prefix}Image; then
		if test -e ${devtype} ${devnum} ${prefix}joyhome/rk3566-joyhome-knx.dtb; then
			echo "Booting the JoyHome 6.18 kernel"
		else
			echo "No JoyHome device tree: booting 5.10"
			setenv kold "true"
		fi
	else
		echo "No 6.18 Image: booting 5.10"
		setenv kold "true"
	fi
fi

setenv bootargs "root=${rootdev} rootwait rootfstype=${rootfstype} ${consoleargs} consoleblank=0 loglevel=${verbosity} ubootpart=${partuuid} usb-storage.quirks=${usbstoragequirks} ${extraargs} ${extraboardargs}"

if test "${docker_optimizations}" = "on"; then setenv bootargs "${bootargs} cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1"; fi

if test "${kold}" = "true"; then
	# ---- Orange Pi 5.10, as shipped ----
	load ${devtype} ${devnum} ${ramdisk_addr_r} ${prefix}k510/uInitrd
	load ${devtype} ${devnum} ${kernel_addr_r} ${prefix}k510/Image

	load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}k510/dtb/${fdtfile}
	fdt addr ${fdt_addr_r}
	fdt resize 65536

	for overlay_file in ${overlays}; do
		if load ${devtype} ${devnum} ${load_addr} ${prefix}k510/dtb/rockchip/overlay/${overlay_prefix}-${overlay_file}.dtbo; then
			echo "Applying kernel provided DT overlay ${overlay_prefix}-${overlay_file}.dtbo"
			fdt apply ${load_addr} || setenv overlay_error "true"
		fi
	done

	for overlay_file in ${user_overlays}; do
		if load ${devtype} ${devnum} ${load_addr} ${prefix}overlay-user/${overlay_file}.dtbo; then
			echo "Applying user provided DT overlay ${overlay_file}.dtbo"
			fdt apply ${load_addr} || setenv overlay_error "true"
		fi
	done
	if test "${overlay_error}" = "true"; then
		echo "Error applying DT overlays, restoring original DT"
		load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}k510/dtb/${fdtfile}
	else
		if load ${devtype} ${devnum} ${load_addr} ${prefix}k510/dtb/rockchip/overlay/${overlay_prefix}-fixup.scr; then
			echo "Applying kernel provided DT fixup script (${overlay_prefix}-fixup.scr)"
			source ${load_addr}
		fi
		if test -e ${devtype} ${devnum} ${prefix}fixup.scr; then
			load ${devtype} ${devnum} ${load_addr} ${prefix}fixup.scr
			echo "Applying user provided fixup script (fixup.scr)"
			source ${load_addr}
		fi
	fi
else
	# ---- JoyHome 6.18 kernel with its own device tree (overlays are built in) ----
	setenv bootargs "${bootargs} panic=10"
	setenv dtbfile "joyhome/rk3566-joyhome-knx.dtb"
	# Experimental NPU (joyhome-npu enable): npu.txt asks for the NPU device
	# tree. Each NPU boot writes npupending.txt first; kernel-trial-confirm
	# deletes it once the box is healthy. If a boot finds it still there, the
	# last NPU boot failed: write npuoff.txt and boot without the NPU.
	if test -e ${devtype} ${devnum} ${prefix}npu.txt; then
		if test -e ${devtype} ${devnum} ${prefix}npuoff.txt; then
			echo "NPU switched off after a failed NPU boot (npuoff.txt)"
		elif test -e ${devtype} ${devnum} ${prefix}npupending.txt; then
			echo "Last NPU boot never confirmed: booting without the NPU"
			fatwrite ${devtype} ${devnum}:1 ${load_addr} npuoff.txt 1
		elif test -e ${devtype} ${devnum} ${prefix}joyhome/rk3566-joyhome-knx-npu.dtb; then
			echo "Booting with the NPU device tree"
			fatwrite ${devtype} ${devnum}:1 ${load_addr} npupending.txt 1
			setenv dtbfile "joyhome/rk3566-joyhome-knx-npu.dtb"
			setenv bootargs "${bootargs} cma=256M"
		fi
	fi
	load ${devtype} ${devnum} ${ramdisk_addr_r} ${prefix}uInitrd
	load ${devtype} ${devnum} ${kernel_addr_r} ${prefix}Image

	load ${devtype} ${devnum} ${fdt_addr_r} ${prefix}${dtbfile}
	fdt addr ${fdt_addr_r}
	fdt resize 65536
fi

if test "${ethernet_phy}" = "rtl8211f"; then
        fdt set /ethernet@ff540000 tx_delay <0x24>
        fdt set /ethernet@ff540000 rx_delay <0x18>
fi

adc_read 3

if test "${board_flag}" = "1"; then
	echo "right device"
	echo "you can boot now"
	booti ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}
	# only reached if u-boot refused to start the kernel
	if test "${kold}" = "false"; then
		fatwrite ${devtype} ${devnum}:1 ${load_addr} booti-failed.txt 1
		reset
	fi
else
	echo "wrong device"
	echo "reboot now"
	reset
fi
