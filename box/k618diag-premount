#!/bin/sh
# /etc/initramfs-tools/scripts/init-premount/k618diag
# During a JoyHome kernel trial only: save the kernel log to /boot before root is mounted.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
case "$(uname -r)" in 5.10.*) exit 0 ;; esac
mkdir -p /run/k618diag
i=0; while [ ! -b /dev/mmcblk0p1 ] && [ $i -lt 15 ]; do sleep 1; i=$((i+1)); done
if mount -t vfat /dev/mmcblk0p1 /run/k618diag 2>/dev/null; then
	if [ -e /run/k618diag/ktrial.txt ] || [ -e /run/k618diag/ktest.txt ]; then
		{ echo "== init-premount, waited ${i}s for mmcblk0p1"; cat /proc/cmdline; ls -l /dev/mmc* /dev/disk/by-uuid/ 2>&1; echo "== dmesg"; dmesg; } > /run/k618diag/k618-premount.log 2>&1
		sync
	fi
	umount /run/k618diag
fi
exit 0
