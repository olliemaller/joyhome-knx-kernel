[Unit]
Description=Confirm a kernel or NPU trial boot (or fall back)
After=network-online.target docker.service knxd.service
Wants=network-online.target
ConditionPathExists=|/boot/ktrial.txt
ConditionPathExists=|/boot/npupending.txt

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 90
ExecStart=/usr/local/sbin/kernel-trial-confirm
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
